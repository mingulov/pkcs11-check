# Third-party test vector data (bind-mounted at runtime, not copied)
data/

# Local builds (large, not needed in Docker)
local-builds/

# Virtual environments (host venv must not leak into container)
.venv/

# Worktrees
.worktrees/

# Git internals
.git/
python-pkcs11/.git/

# Python caches
**/__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Artifacts from previous Docker runs
artifacts/
