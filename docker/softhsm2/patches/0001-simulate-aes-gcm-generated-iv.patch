From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pkcs11-check <pkcs11-check@example.invalid>
Date: Mon, 4 May 2026 00:00:00 +0000
Subject: [PATCH] SoftHSM2: simulate AES-GCM generated IV writeback

Add a local SoftHSM generated-IV simulator for pkcs11-check's positive
classic CKM_AES_GCM provider-writeback tests.

The simulator is intentionally narrow:

* strict convention: ulIvLen == 0 and ulIvBits == 96;
* AWS-style convention: ulIvLen is a caller buffer size of at least 12 bytes
  and ulIvBits == 0;
* C_EncryptInit generates exactly a 12-byte IV, writes it to CK_GCM_PARAMS.pIv,
  and uses those bytes for encryption;
* decrypt remains unchanged and requires the encryption IV explicitly.

This patch is for pkcs11-check's simulator Docker target. It is not intended to
represent stock SoftHSM2 behavior or a general SoftHSM2 feature.
---
 src/lib/SoftHSM.cpp | 63 +++++++++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 57 insertions(+), 6 deletions(-)

diff --git a/src/lib/SoftHSM.cpp b/src/lib/SoftHSM.cpp
index 8a2a73c..600002f 100644
--- a/src/lib/SoftHSM.cpp
+++ b/src/lib/SoftHSM.cpp
@@ -2359,0 +2360 @@ CK_RV SoftHSM::SymEncryptInit(CK_SESSION_HANDLE hSession, CK_MECHANISM_PTR pMech
+		{
@@ -2370,6 +2371,55 @@ CK_RV SoftHSM::SymEncryptInit(CK_SESSION_HANDLE hSession, CK_MECHANISM_PTR pMech
-			iv.resize(CK_GCM_PARAMS_PTR(pMechanism->pParameter)->ulIvLen);
-			memcpy(&iv[0], CK_GCM_PARAMS_PTR(pMechanism->pParameter)->pIv, CK_GCM_PARAMS_PTR(pMechanism->pParameter)->ulIvLen);
-			aad.resize(CK_GCM_PARAMS_PTR(pMechanism->pParameter)->ulAADLen);
-			if (CK_GCM_PARAMS_PTR(pMechanism->pParameter)->ulAADLen > 0)
-				memcpy(&aad[0], CK_GCM_PARAMS_PTR(pMechanism->pParameter)->pAAD, CK_GCM_PARAMS_PTR(pMechanism->pParameter)->ulAADLen);
-			tagBytes = CK_GCM_PARAMS_PTR(pMechanism->pParameter)->ulTagBits;
+			CK_GCM_PARAMS_PTR gcmParams = CK_GCM_PARAMS_PTR(pMechanism->pParameter);
+			CK_ULONG effectiveIvLen = gcmParams->ulIvLen;
+
+			// SoftHSM generated-IV simulator for pkcs11-check:
+			// - strict convention: ulIvLen == 0, ulIvBits == 96
+			// - AWS-style convention: ulIvLen is the caller buffer size and ulIvBits == 0
+			if (gcmParams->ulIvLen == 0 || gcmParams->ulIvBits == 0)
+			{
+				const CK_ULONG generatedIvLen = 12;
+
+				if (gcmParams->pIv == NULL_PTR)
+				{
+					DEBUG_MSG("Generated AES-GCM IV simulation requires pIv");
+					return CKR_MECHANISM_PARAM_INVALID;
+				}
+
+				if (gcmParams->ulIvLen == 0)
+				{
+					if (gcmParams->ulIvBits != generatedIvLen * 8)
+					{
+						DEBUG_MSG("Generated AES-GCM IV simulation requires ulIvBits == 96");
+						return CKR_MECHANISM_PARAM_INVALID;
+					}
+					gcmParams->ulIvLen = generatedIvLen;
+					effectiveIvLen = generatedIvLen;
+				}
+				else
+				{
+					if (gcmParams->ulIvLen < generatedIvLen)
+					{
+						DEBUG_MSG("Generated AES-GCM IV simulation requires a 12-byte pIv buffer");
+						return CKR_MECHANISM_PARAM_INVALID;
+					}
+					effectiveIvLen = generatedIvLen;
+				}
+
+				RNG* rng = CryptoFactory::i()->getRNG();
+				if (rng == NULL) return CKR_DEVICE_ERROR;
+
+				ByteString generatedIv;
+				if (!rng->generateRandom(generatedIv, generatedIvLen))
+					return CKR_DEVICE_ERROR;
+
+				memcpy(gcmParams->pIv, generatedIv.const_byte_str(), generatedIvLen);
+			}
+
+			if (effectiveIvLen == 0 || gcmParams->pIv == NULL_PTR)
+				return CKR_MECHANISM_PARAM_INVALID;
+
+			iv.resize(effectiveIvLen);
+			memcpy(&iv[0], gcmParams->pIv, effectiveIvLen);
+			aad.resize(gcmParams->ulAADLen);
+			if (gcmParams->ulAADLen > 0)
+				memcpy(&aad[0], gcmParams->pAAD, gcmParams->ulAADLen);
+			tagBytes = gcmParams->ulTagBits;
@@ -2382,0 +2433 @@ CK_RV SoftHSM::SymEncryptInit(CK_SESSION_HANDLE hSession, CK_MECHANISM_PTR pMech
+		}
--
2.43.0
