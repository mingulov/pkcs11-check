# SoftHSM2 main — latest development branch with GOST + ML-DSA
# Requires OpenSSL 3.5+ for ML-DSA support (Fedora 44 has it)

FROM quay.io/fedora/fedora:44 AS builder

RUN dnf -y install git make gcc gcc-c++ openssl-devel sqlite-devel \
    automake autoconf autoconf-archive libtool pkg-config openssl \
    && dnf clean all

# Verify OpenSSL version (need 3.5+ for ML-DSA)
RUN openssl version

RUN git clone --depth 1 --branch main https://github.com/softhsm/SoftHSMv2.git /build/softhsm2
WORKDIR /build/softhsm2
RUN sh autogen.sh && \
    ./configure --prefix=/usr --sysconfdir=/etc \
    --with-crypto-backend=openssl --enable-mldsa \
    --disable-dependency-tracking && \
    make -j$(nproc) && \
    make DESTDIR=/install install

# ---------- runtime ----------
FROM quay.io/fedora/fedora:44

RUN dnf -y install python3.12 python3.12-devel gcc git openssl sqlite \
    && dnf clean all

COPY --from=builder /install/usr /usr

ENV SOFTHSM2_CONF=/etc/softhsm2.conf
RUN mkdir -p /var/lib/softhsm/tokens && \
    echo "directories.tokendir = /var/lib/softhsm/tokens" > $SOFTHSM2_CONF && \
    echo "objectstore.backend = file" >> $SOFTHSM2_CONF && \
    softhsm2-util --init-token --slot 0 --label "pkcs11-check" --pin 1234 --so-pin 12345678

ENV PKCS11_CHECK_MODULE=/usr/lib64/softhsm/libsofthsm2.so
ENV PKCS11_CHECK_PIN=1234
ENV PKCS11_CHECK_PYTHON=python3.12

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /app
# Install deps first (cached unless pyproject.toml/uv.lock/python-pkcs11 change)
COPY pyproject.toml uv.lock README.md ./
COPY python-pkcs11/ python-pkcs11/
COPY src/pkcs11_check/__init__.py src/pkcs11_check/__init__.py
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_PYTHON_PKCS11=0.0
RUN uv sync --frozen --reinstall-package python-pkcs11 --python python3.12

# Copy test code (changes frequently, does not invalidate deps cache)
COPY . .

CMD ["bash", "/app/docker/run-with-artifacts.sh", "bash", "/app/docker/run-pkcs11-check.sh"]
