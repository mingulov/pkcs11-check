# SoftHSM2 git ref + OpenSSL built from source
#
# Usage:
#   docker compose -f docker/docker-compose.test.yml run --build test-softhsm2-main
#
# Override OpenSSL version:
#   docker compose -f docker/docker-compose.test.yml build \
#     --build-arg OPENSSL_VERSION=3.6.2 test-softhsm2-main

FROM quay.io/fedora/fedora:44 AS builder

ARG OPENSSL_VERSION=4.0.0
ARG SOFTHSM2_REF=main
ARG SOFTHSM2_APPLY_GENERATED_IV_PATCH=0

RUN dnf -y install git make gcc gcc-c++ sqlite-devel perl-core \
    automake autoconf autoconf-archive libtool pkg-config \
    && dnf clean all

# Build OpenSSL from source
RUN mkdir -p /build && \
    curl -fsSL https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz \
    | tar xz -C /build/ && \
    cd /build/openssl-${OPENSSL_VERSION} && \
    ./Configure --prefix=/opt/openssl --openssldir=/opt/openssl/ssl \
    shared linux-x86_64 && \
    make -j$(nproc) && \
    make install_sw install_ssldirs

ENV LD_LIBRARY_PATH=/opt/openssl/lib64
RUN /opt/openssl/bin/openssl version

COPY docker/softhsm2/patches/ /tmp/softhsm2-patches/

# Build SoftHSM2 against custom OpenSSL.
RUN git clone --depth 1 --branch ${SOFTHSM2_REF} https://github.com/softhsm/SoftHSMv2.git /build/softhsm2
WORKDIR /build/softhsm2
RUN if [ "${SOFTHSM2_APPLY_GENERATED_IV_PATCH}" = "1" ]; then \
        git apply --unidiff-zero /tmp/softhsm2-patches/0001-simulate-aes-gcm-generated-iv.patch; \
    fi && \
    sh autogen.sh && \
    mldsa_arg="" && \
    if ./configure --help | grep -q -- "--enable-mldsa"; then \
        mldsa_arg="--enable-mldsa"; \
    fi && \
    PKG_CONFIG_PATH=/opt/openssl/lib64/pkgconfig \
    CPPFLAGS="-I/opt/openssl/include" \
    LDFLAGS="-L/opt/openssl/lib64 -Wl,-rpath,/opt/openssl/lib64" \
    ./configure --prefix=/usr --sysconfdir=/etc \
    --with-crypto-backend=openssl ${mldsa_arg} \
    --disable-dependency-tracking && \
    make -j$(nproc) && \
    make DESTDIR=/install install

# ---------- runtime ----------
FROM quay.io/fedora/fedora:44

RUN dnf -y install python3.14 python3.14-devel gcc git sqlite \
    && dnf clean all

# Test tooling: fault-proxy, pkcs11-provider, p11-kit
COPY docker/fault-proxy.c /tmp/fault-proxy.c
COPY docker/install-test-tools.sh /tmp/install-test-tools.sh
RUN bash /tmp/install-test-tools.sh && rm -f /tmp/install-test-tools.sh

COPY --from=builder /opt/openssl /opt/openssl
COPY --from=builder /install/usr /usr

# Enable OpenSSL legacy provider so SoftHSM can exercise legacy mechanisms such
# as DES/3DES when built against OpenSSL 3.6/4.0.
RUN printf 'openssl_conf = openssl_init\nconfig_diagnostics = 1\n\n[openssl_init]\nproviders = provider_sect\n\n[provider_sect]\ndefault = default_sect\nlegacy = legacy_sect\n\n[default_sect]\nactivate = 1\n\n[legacy_sect]\nactivate = 1\n' \
    > /opt/openssl/ssl/openssl.cnf

ENV LD_LIBRARY_PATH=/opt/openssl/lib64
ENV PATH=/opt/openssl/bin:${PATH}
ENV OPENSSL_CONF=/opt/openssl/ssl/openssl.cnf
ENV SOFTHSM2_CONF=/etc/softhsm2.conf
RUN mkdir -p /var/lib/softhsm/tokens && \
    echo "directories.tokendir = /var/lib/softhsm/tokens" > $SOFTHSM2_CONF && \
    echo "objectstore.backend = file" >> $SOFTHSM2_CONF && \
    softhsm2-util --init-token --slot 0 --label "pkcs11-check" --pin 1234 --so-pin 12345678

RUN /opt/openssl/bin/openssl version

ENV PKCS11_CHECK_MODULE=/usr/lib64/softhsm/libsofthsm2.so
ENV PKCS11_CHECK_PIN=1234

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src/pkcs11_check/__init__.py src/pkcs11_check/__init__.py
COPY third_party/ third_party/
RUN uv sync --frozen

COPY . .

CMD ["bash", "/app/docker/run-with-artifacts.sh", "bash", "/app/docker/run-pkcs11-check.sh"]
