# Kryoptic main — latest development (no FIPS, default features)

FROM rust:latest AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    git pkg-config libssl-dev clang make \
    && rm -rf /var/lib/apt/lists/*

# Copy and apply patches from pkcs11-check patches directory
# Bust cache if patches change: 2026-03-30-05
COPY patches/kryoptic/*.patch /tmp/patches/

RUN git clone --depth 1 https://github.com/latchset/kryoptic.git /build/kryoptic
WORKDIR /build/kryoptic
RUN for p in /tmp/patches/*.patch; do \
        if [ -f "$p" ]; then \
            echo "Applying patch: $p"; \
            git apply --ignore-space-change --ignore-whitespace "$p" || echo "Warning: Failed to apply $p"; \
        fi; \
    done
RUN cargo build --release --features pqc 2>&1 | tail -3

FROM python:3.14-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 git gcc python3-dev libssl-dev opensc \
    && rm -rf /var/lib/apt/lists/*

# Test tooling: fault-proxy, pkcs11-provider, p11-kit
COPY docker/fault-proxy.c /tmp/fault-proxy.c
COPY docker/install-test-tools.sh /tmp/install-test-tools.sh
RUN bash /tmp/install-test-tools.sh && rm -f /tmp/install-test-tools.sh

COPY --from=builder /build/kryoptic/target/release/libkryoptic_pkcs11.so /usr/lib/

RUN mkdir -p /var/lib/kryoptic /etc/kryoptic && \
    printf '[[slots]]\nslot = 1\ndbtype = "sqlite"\ndbargs = "/var/lib/kryoptic/token.sql"\n' \
    > /etc/kryoptic/token.conf
ENV KRYOPTIC_CONF=/etc/kryoptic/token.conf

RUN pkcs11-tool --module /usr/lib/libkryoptic_pkcs11.so \
    --init-token --label "pkcs11-check" --so-pin 12345678 && \
    pkcs11-tool --module /usr/lib/libkryoptic_pkcs11.so \
    --init-pin --pin 1234 --so-pin 12345678

ENV PKCS11_CHECK_MODULE=/usr/lib/libkryoptic_pkcs11.so
ENV PKCS11_CHECK_PIN=1234

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /app
# Install deps first (cached unless pyproject.toml/uv.lock change)
COPY pyproject.toml uv.lock README.md ./
COPY src/pkcs11_check/__init__.py src/pkcs11_check/__init__.py
COPY third_party/ third_party/
RUN uv sync --frozen

# Copy test code (changes frequently, does not invalidate deps cache)
COPY . .

CMD ["bash", "/app/docker/run-with-artifacts.sh", "bash", "/app/docker/run-pkcs11-check.sh"]
