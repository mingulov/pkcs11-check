diff --git a/src/token/token.rs b/src/token/token.rs
index 710acc7..3ac37dc 100644
--- a/src/token/token.rs
+++ b/src/token/token.rs
@@ -170,7 +170,7 @@ impl Token {
             auth_state.so_pin_locked = data.so_pin_locked;
         }
 
-        Self {
+        let token = Self {
             label: RwLock::new(label),
             so_pin_hash: RwLock::new(None),
             user_pin_hash: RwLock::new(None),
@@ -184,7 +184,27 @@ impl Token {
             max_failed_logins,
             pbkdf2_iterations,
             lockout_store,
+        };
+
+        // pkcs11-check test patch: auto-provision the token from config so every
+        // process sees a ready token. craton's in-process module keeps token auth in
+        // memory only, and pkcs11-check runs each test file in its own subprocess, so
+        // without this each subprocess starts unprovisioned and C_Login fails. The
+        // SO/user PIN are set directly (config is trusted). Test deployments only.
+        if let Some(cfg) = config {
+            if let (Some(so_pin), Some(user_pin)) = (
+                cfg.security.initial_so_pin.as_ref(),
+                cfg.security.initial_user_pin.as_ref(),
+            ) {
+                *token.so_pin_hash.write() = Some(token.hash_pin(so_pin.as_bytes()));
+                *token.user_pin_hash.write() = Some(token.hash_pin(user_pin.as_bytes()));
+                let mut auth = token.auth.lock();
+                auth.initialized = true;
+                auth.user_pin_initialized = true;
+            }
         }
+
+        token
     }
 
     /// Persist the current lockout counters to disk (if a store is configured).
