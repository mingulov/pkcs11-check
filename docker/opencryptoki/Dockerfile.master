# OpenCryptoki master — latest development branch (built from source)
# IBM's PKCS#11 implementation with SWToken backend

FROM fedora:44 AS builder

RUN dnf -y install git gcc gcc-c++ make automake autoconf autoconf-archive libtool \
    openssl-devel sqlite-devel trousers-devel libcap-devel openldap-devel \
    bison flex \
    && dnf clean all

RUN git clone --depth 1 https://github.com/opencryptoki/opencryptoki.git /build/opencryptoki
WORKDIR /build/opencryptoki
RUN sh bootstrap.sh && \
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
    --enable-swtok --disable-icatok --disable-ccatok --disable-ep11tok \
    --disable-tpmtok --disable-icsftok --disable-p11sak && \
    make -j$(nproc) && \
    make install && \
    ls -la /usr/lib64/pkcs11/ /usr/lib64/opencryptoki/ 2>/dev/null || true

# ---------- runtime ----------
FROM fedora:44

RUN dnf -y install python3.12 python3.12-devel gcc git openssl procps-ng libcap \
    && dnf clean all

# Copy built opencryptoki from builder's /usr
COPY --from=builder /usr/lib64/pkcs11/ /usr/lib64/pkcs11/
COPY --from=builder /usr/lib64/opencryptoki/ /usr/lib64/opencryptoki/
COPY --from=builder /usr/sbin/pkcsslotd /usr/sbin/pkcsslotd
COPY --from=builder /usr/bin/pkcsconf /usr/bin/pkcsconf
COPY --from=builder /etc/opencryptoki/ /etc/opencryptoki/
RUN ldconfig

# OpenCryptoki runtime directories
RUN mkdir -p /var/lib/opencryptoki/swtok/TOK_OBJ \
    /var/lock/opencryptoki /run/opencryptoki && \
    chmod -R 770 /var/lib/opencryptoki /var/lock/opencryptoki /run/opencryptoki

# Override config to put SW token at slot 0
RUN printf 'version opencryptoki-3\n\nslot 0\n{\n    stdll = libpkcs11_sw.so\n    tokversion = 3.12\n}\n' \
    > /etc/opencryptoki/opencryptoki.conf

ENV PKCS11_CHECK_MODULE=/usr/lib64/pkcs11/libopencryptoki.so
ENV PKCS11_CHECK_PIN=1234
ENV PKCS11_CHECK_PYTHON=python3.12

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY python-pkcs11/ python-pkcs11/
COPY src/pkcs11_check/__init__.py src/pkcs11_check/__init__.py
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_PYTHON_PKCS11=0.0
RUN uv sync --frozen --python python3.12

COPY . .

# Add root to pkcs11 group
RUN groupadd -f pkcs11 && usermod -a -G pkcs11 root

CMD ["bash", "/app/docker/run-with-artifacts.sh", "bash", "/app/docker/opencryptoki/run-opencryptoki.sh"]
